desc:LALA Wrapper UI
slider1:0.3<0,1,0.001>-Gain
slider2:0.25<0,1,0.001>-Peak Reduction

@init
drag = 0;
last_cap = 0;
changed = 0;
last_click_id = 0;
last_click_t = 0;

colr = 0.5;
colg = 0.5;
colb = 0.5;

dragy = 0;
dragv = 0;

gfx_ext_flags = 256;

bg_w = 0;
bg_h = 0;

defv = 100;
defv[1] = 0.3;
defv[2] = 0.25;

function setcol(r, g, b)
(
  colr = r;
  colg = g;
  colb = b;
);


// ============================================================
// METALLIC LALA BACKGROUND
// ============================================================

function build_bg(bw, bh)
  local(x, y, n, n2, base, rr, gg, bb)
(
  gfx_dest = 1;
  gfx_setimgdim(1, bw, bh);

  y = 0;

  loop(bh,

    x = 0;

    loop(bw,

      // Fine pseudo-random metallic grain
      n = sin(
        x*12.9898 +
        y*78.233
      ) * 43758.5453;

      n = n - floor(n);

      // A second, slightly larger-scale variation
      n2 = sin(
        x*0.37 +
        y*3.17
      ) * 43758.5453;

      n2 = n2 - floor(n2);

      // Warm gray / olive LALA faceplate.
      // Slightly darker toward the bottom.
      base =
        0.722
        - 0.020*(y/bh)
        + (n - 0.5)*0.016
        + (n2 - 0.5)*0.004;

      // Slight warm/olive color balance
      rr = base + 0.006;
      gg = base;
      bb = base - 0.075;

      // Put the pixel at the current image position
      gfx_x = x;
      gfx_y = y;

      gfx_setpixel(
        rr,
        gg,
        bb
      );

      x += 1;
    );

    y += 1;
  );

  gfx_dest = -1;
);


// ============================================================
// KNOB
// ============================================================

function knob(id, x, y, r, v)
  local(a, dx, dy, now, i, t)
(
  dx = mouse_x - x;
  dy = mouse_y - y;
  now = time_precise();

  ((mouse_cap & 1) &&
   (last_cap == 0) &&
   ((dx*dx + dy*dy) < (r*r*1.3))) ? (

    ((last_click_id == id) &&
     ((now - last_click_t) < 0.35)) ? (

      v = defv[id];
      changed = id;
      drag = 0;
      last_click_id = 0;

    ) : (

      drag = id;
      dragy = mouse_y;
      dragv = v;
      last_click_id = id;
      last_click_t = now;
    );
  );

  ((drag == id) && (mouse_cap & 1)) ? (
    v = max(
      0,
      min(
        1,
        dragv + (dragy - mouse_y) * 0.005
      )
    );

    changed = id;
  );


  // ----------------------------------------------------------
  // Tick marks
  // ----------------------------------------------------------

  gfx_set(
    0.13,
    0.13,
    0.12
  );

  i = 0;

  loop(11,

    t = $pi*0.75 + i*$pi*0.15;

    gfx_circle(
      x + cos(t)*r*1.3,
      y + sin(t)*r*1.3,
      max(1, r*0.06),
      1,
      1
    );

    i += 1;
  );


  // ----------------------------------------------------------
  // Drop shadow
  // ----------------------------------------------------------

  gfx_set(
    0,
    0,
    0,
    0.35
  );

  gfx_circle(
    x + r*0.10,
    y + r*0.16,
    r + 2,
    1,
    1
  );

  gfx_a = 1;


  // ----------------------------------------------------------
  // Black outer skirt
  // ----------------------------------------------------------

  gfx_set(
    0.035,
    0.035,
    0.033
  );

  gfx_circle(
    x,
    y,
    r + 1.5,
    1,
    1
  );


  // ----------------------------------------------------------
  // Metallic rim
  // ----------------------------------------------------------

  gfx_set(
    0.48,
    0.48,
    0.46
  );

  gfx_circle(
    x,
    y,
    r + 0.5,
    1,
    1
  );


  // ----------------------------------------------------------
  // Dark graphite inner metal
  // ----------------------------------------------------------

  gfx_set(
    0.12,
    0.12,
    0.115
  );

  gfx_circle(
    x,
    y,
    r - 0.5,
    1,
    1
  );


  // ----------------------------------------------------------
  // Main knob surface
  // ----------------------------------------------------------

  gfx_set(
    0.19,
    0.19,
    0.18
  );

  gfx_circle(
    x,
    y,
    r*0.88,
    1,
    1
  );


  // ----------------------------------------------------------
  // Top-left metallic reflection
  // ----------------------------------------------------------

  gfx_set(
    1,
    1,
    1,
    0.13
  );

  gfx_circle(
    x - r*0.18,
    y - r*0.24,
    r*0.55,
    1,
    1
  );


  // ----------------------------------------------------------
  // Bottom-right shading
  // ----------------------------------------------------------

  gfx_set(
    0,
    0,
    0,
    0.20
  );

  gfx_circle(
    x + r*0.22,
    y + r*0.28,
    r*0.50,
    1,
    1
  );

  gfx_a = 1;


  // ----------------------------------------------------------
  // Pointer
  // ----------------------------------------------------------

  a = $pi*0.75 + v*$pi*1.5;

  gfx_set(
    0.90,
    0.89,
    0.82
  );

  gfx_line(
    x + cos(a)*r*0.20,
    y + sin(a)*r*0.20,
    x + cos(a)*r*0.95,
    y + sin(a)*r*0.95
  );

  gfx_line(
    x + cos(a)*r*0.20 + 1,
    y + sin(a)*r*0.20,
    x + cos(a)*r*0.95 + 1,
    y + sin(a)*r*0.95
  );

  v;
);


// ============================================================
// TEXT
// ============================================================

function label(str, cx, ty)
  local(tw, th)
(
  gfx_measurestr(
    str,
    tw,
    th
  );

  gfx_x = cx - tw/2;
  gfx_y = ty;

  gfx_drawstr(str);
);


function tlab(str, frac)
  local(t)
(
  t = $pi*0.75 + frac*$pi*1.5;

  gfx_setfont(1);

  // Dark charcoal
  gfx_set(
    0.10,
    0.10,
    0.09
  );

  label(
    str,
    lx + cos(t)*kr*1.55,
    ly + sin(t)*kr*1.55 - fs*0.5
  );
);


// ============================================================
// CONTROL CELL
// ============================================================

function ccell(id, cx, yt, v, name)
  local(cy)
(
  cy = yt + unit*0.47;

  lx = cx;
  ly = cy;

  v = knob(
    id,
    cx,
    cy,
    kr,
    v
  );

  gfx_setfont(2);

  gfx_set(
    0.10,
    0.10,
    0.09
  );

  label(
    name,
    cx,
    cy + kr*1.15 + fs*0.8
  );

  v;
);


// ============================================================
// GRAPHICS
// ============================================================

@gfx 120 80

gfx_ext_flags = 256;

w = gfx_w;
h = gfx_h;


// ------------------------------------------------------------
// Build background only when size changes
// ------------------------------------------------------------

((w != bg_w) || (h != bg_h)) ? (

  bg_w = w;
  bg_h = h;

  build_bg(
    w,
    h
  );
);


// ------------------------------------------------------------
// Draw textured faceplate
// ------------------------------------------------------------

gfx_a = 1;

gfx_x = 0;
gfx_y = 0;

gfx_blit(
  1,
  1,
  0
);


// ============================================================
// LAYOUT
// ============================================================

m = max(
  3,
  w * 0.03
);

cw = (w - 2*m) / 2;

cx1 = m + cw*0.5;
cx2 = m + cw*1.5;

unit = 0;

y1 = h * 0.5 - 6;


// Keep original knob size
kr = min(
  cw*0.30,
  16
);

fs = max(
  7,
  min(cw, 80)*0.17
);

gfx_setfont(
  1,
  "Arial",
  fs
);

gfx_setfont(
  2,
  "Arial",
  fs*1.05,
  98
);

changed = 0;


// ============================================================
// GAIN
// ============================================================

setcol(
  0.19,
  0.19,
  0.18
);

slider1 = ccell(
  1,
  cx1,
  y1,
  slider1,
  "GAIN"
);

tlab("0", 0);
tlab("100", 1);


// ============================================================
// PEAK REDUCTION
// ============================================================

setcol(
  0.19,
  0.19,
  0.18
);

slider2 = ccell(
  2,
  cx2,
  y1,
  slider2,
  "PEAK RED"
);

tlab("0", 0);
tlab("100", 1);


// ============================================================
// AUTOMATION / MOUSE
// ============================================================

(changed == 1) ? slider_automate(slider1);
(changed == 2) ? slider_automate(slider2);

last_cap = mouse_cap & 1;

(last_cap == 0) ? (
  drag = 0;
);
