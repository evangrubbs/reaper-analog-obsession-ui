desc:SSQ UI
slider1:0<0,1,0.001>HPF Freq
slider2:1<0,1,0.001>LPF Freq
slider3:0.5<0,1,0.001>HF Gain
slider4:0.5<0,1,0.001>LF Gain
slider5:1<0,1,1{Off,On}>Filter In
slider7:0.448<0,1,0.001>HF kHz
slider8:0<0,1,1{Shelf,Bell}>HF Bell
slider9:0.5<0,1,0.001>HMF Gain
slider10:0.751<0,1,0.001>HMF kHz
slider11:0.5<0,1,0.001>HMF Q
slider12:0.5<0,1,0.001>LMF Gain
slider13:0.363<0,1,0.001>LMF kHz
slider14:0.5<0,1,0.001>LMF Q
slider15:0.256<0,1,0.001>LF Hz
slider16:0<0,1,1{Shelf,Bell}>LF Bell
slider17:0.5<0,1,0.001>Input
slider18:0.5<0,1,0.001>Output
slider19:1<0,1,1{Off,On}>EQ In

@init
drag = 0;
last_cap = 0;
changed = 0;
last_click_id = 0;
last_click_t = 0;
colr = 0.5; colg = 0.5; colb = 0.5;
bg_w = 0;
bg_h = 0;
gfx_ext_flags = 256;
kdown = 3;   // pixels to push every knob down (raise it if a knob still touches its text)
tipx = 0;
tipy = 0;

// ---- DEFAULTS (double-click reset values, 0..1) ----
defv = 100;
defv[1]  = 0;      // HPF freq (off position)
defv[2]  = 1;      // LPF freq (off position)
defv[3]  = 0.5;    // HF gain (0 dB)
defv[4]  = 0.5;    // LF gain (0 dB)
defv[7]  = 0.448;  // HF kHz  -> 8 kHz
defv[9]  = 0.5;    // HMF gain (0 dB)
defv[10] = 0.751;  // HMF kHz -> 3.8 kHz
defv[11] = 0.5;    // HMF Q
defv[12] = 0.5;    // LMF gain (0 dB)
defv[13] = 0.363;  // LMF kHz -> 0.5 kHz
defv[14] = 0.5;    // LMF Q
defv[15] = 0.256;  // LF Hz   -> 60 Hz
defv[17] = 0.5;    // Input
defv[18] = 0.5;    // Output

function setcol(r, g, b)
(
  colr = r; colg = g; colb = b;
);

// ---- FLOATING VALUE READOUT ----
function valstr(id, v)
(
  (id == 1)  ? ( (v < 0.002) ? strcpy(#tip, "OFF") : sprintf(#tip, "%.0f Hz", 16 + (350 - 16)*v*v) );   // squared taper
  (id == 2)  ? ( (v > 0.998) ? strcpy(#tip, "OFF") : sprintf(#tip, "%.2f kHz", 1 + (20 - 1)*v) );       // linear
  (id == 7)  ? sprintf(#tip, "%.2f kHz", 1.5 + v*(16 - 1.5));          // linear
  (id == 10) ? sprintf(#tip, "%.2f kHz", 0.6*exp(v*log(7/0.6)));       // log
  (id == 13) ? sprintf(#tip, "%.2f kHz", 0.2*exp(v*log(2.5/0.2)));     // log
  (id == 15) ? sprintf(#tip, "%.0f Hz",  30*exp(v*log(450/30)));       // log
  ((id == 3) || (id == 4) || (id == 9) || (id == 12)) ? sprintf(#tip, "%+.1f dB", (v - 0.5)*40);
  ((id == 11) || (id == 14)) ? sprintf(#tip, "Q %.2f", v);
  ((id == 17) || (id == 18)) ? sprintf(#tip, "%+.1f dB", (v - 0.5)*48);
);

function tipbox()
  local(tw, th, bw3, bh3, bx3, by3)
(
  gfx_setfont(2);
  gfx_measurestr(#tip, tw, th);
  bw3 = tw + 12;
  bh3 = th + 6;
  bx3 = max(1, min(w - bw3 - 1, tipx - bw3/2));
  by3 = tipy - kr - bh3 - 6;
  (by3 < 1) ? by3 = tipy + kr + 6;     // flip below if no room above

  gfx_set(0, 0, 0, 0.5);
  gfx_rect(bx3 + 2, by3 + 2, bw3, bh3);     // shadow
  gfx_set(0.07, 0.07, 0.07, 0.96);
  gfx_rect(bx3, by3, bw3, bh3);             // body
  gfx_set(0.6, 0.6, 0.6);
  gfx_rect(bx3, by3, bw3, 1);               // border
  gfx_rect(bx3, by3 + bh3 - 1, bw3, 1);
  gfx_rect(bx3, by3, 1, bh3);
  gfx_rect(bx3 + bw3 - 1, by3, 1, bh3);
  gfx_a = 1;

  gfx_set(1, 0.85, 0.3);                    // amber text
  gfx_x = bx3 + 6;
  gfx_y = by3 + 3;
  gfx_drawstr(#tip);
);

// vertical grey gradient, built from 1px rows
function vgrad(x, y, w2, h2, c0, c1)
  local(i, n, c)
(
  n = max(1, floor(h2));
  i = 0;
  loop(n,
    c = c0 + (c1 - c0)*(i/n);
    gfx_set(c, c, c);
    gfx_rect(x, y + i, w2, 1);
    i += 1;
  );
);

function knob(id, x, y, r, v)
  local(a, dx, dy, now, i, t)
(
  dx = mouse_x - x;
  dy = mouse_y - y;
  now = time_precise();

  ((mouse_cap & 1) && (last_cap == 0) && ((dx*dx + dy*dy) < (r*r*1.3))) ? (
    ((last_click_id == id) && ((now - last_click_t) < 0.35)) ? (
      // double-click: reset to this knob's default
      v = defv[id];
      changed = id;
      drag = 0;
      last_click_id = 0;
    ) : (
      drag = id;
      dragy = mouse_y;
      dragv = v;
      last_click_id = id;
      last_click_t = now;
    );
  );

  ((drag == id) && (mouse_cap & 1)) ? (
    v = max(0, min(1, dragv + (dragy - mouse_y) * 0.005));
    changed = id;
    tipx = x;
    tipy = y;
  );

  // tick dots around the arc
  gfx_set(0.78, 0.78, 0.78);
  i = 0;
  loop(11,
    t = $pi*0.75 + i*$pi*0.15;
    gfx_circle(x + cos(t)*r*1.3, y + sin(t)*r*1.3, max(1, r*0.06), 1, 1);
    i += 1;
  );

  // drop shadow
  gfx_set(0, 0, 0, 0.4);
  gfx_circle(x + r*0.1, y + r*0.2, r + 2, 1, 1);
  gfx_a = 1;

  // skirt, metal rim, cap
  gfx_set(0.04, 0.04, 0.04);
  gfx_circle(x, y, r + 1.5, 1, 1);
  gfx_set(0.55, 0.55, 0.55);
  gfx_circle(x, y, r + 0.5, 1, 1);
  gfx_set(colr*0.55, colg*0.55, colb*0.55);
  gfx_circle(x, y, r - 0.5, 1, 1);
  gfx_set(colr, colg, colb);
  gfx_circle(x, y, r*0.88, 1, 1);

  // soft light from top-left, shade at bottom-right
  gfx_set(1, 1, 1, 0.16);
  gfx_circle(x - r*0.18, y - r*0.24, r*0.55, 1, 1);
  gfx_set(0, 0, 0, 0.16);
  gfx_circle(x + r*0.22, y + r*0.28, r*0.5, 1, 1);
  gfx_a = 1;

  // pointer
  a = $pi*0.75 + v*$pi*1.5;
  gfx_set(1, 1, 1);
  gfx_line(x + cos(a)*r*0.2, y + sin(a)*r*0.2, x + cos(a)*r*0.95, y + sin(a)*r*0.95);
  gfx_line(x + cos(a)*r*0.2 + 1, y + sin(a)*r*0.2, x + cos(a)*r*0.95 + 1, y + sin(a)*r*0.95);
  v;
);

function label(str, cx, ty)
  local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = cx - tw/2;
  gfx_y = ty;
  gfx_drawstr(str);
);

function bellicon(cx, by, wd, ht, k)
  local(i, t, x0, y0, x1, y1)
(
  x0 = cx - wd;
  y0 = by - ht*exp(-k);
  i = 1;
  loop(16,
    t = -1 + i/8;
    x1 = cx + t*wd;
    y1 = by - ht*exp(-k*t*t);
    gfx_line(x0, y0, x1, y1);
    x0 = x1;
    y0 = y1;
    i += 1;
  );
);

// matte metal panel, drawn once into image buffer 1
function build_bg(bw, bh)
  local(x, y, n, rn, base)
(
  gfx_setimgdim(1, bw, bh);
  gfx_dest = 1;
  y = 0;
  loop(bh,
    rn = sin(y*4.1414)*43758.5453;
    rn = rn - floor(rn);
    x = 0;
    loop(bw,
      n = sin(x*12.9898 + y*78.233)*43758.5453;
      n = n - floor(n);
      base = 0.20 - 0.04*(y/bh) + (n - 0.5)*0.045 + (rn - 0.5)*0.012;
      gfx_x = x;
      gfx_y = y;
      gfx_setpixel(base, base, base);
      x += 1;
    );
    y += 1;
  );
  // panel edge bevel
  gfx_set(1, 1, 1, 0.14);
  gfx_rect(0, 0, bw, 1);
  gfx_rect(0, 0, 1, bh);
  gfx_set(0, 0, 0, 0.5);
  gfx_rect(0, bh - 1, bw, 1);
  gfx_rect(bw - 1, 0, 1, bh);
  gfx_a = 1;
  gfx_dest = -1;
);

// section divider: engraved groove with a raised name plate
function tab(str, ty, th2)
  local(tw, thh, bw2, bx)
(
  gfx_set(0, 0, 0, 0.55);
  gfx_rect(m, ty + th2*0.5, w - 2*m, 1);
  gfx_set(1, 1, 1, 0.12);
  gfx_rect(m, ty + th2*0.5 + 1, w - 2*m, 1);
  gfx_a = 1;

  gfx_setfont(2);
  gfx_measurestr(str, tw, thh);
  bw2 = tw + 16;
  bx = w/2 - bw2/2;

  gfx_set(0, 0, 0, 0.5);
  gfx_rect(bx, ty + 1, bw2 + 1, th2 + 1);
  gfx_a = 1;
  vgrad(bx, ty, bw2, th2, 0.93, 0.74);
  gfx_set(1, 1, 1, 0.8);
  gfx_rect(bx, ty, bw2, 1);
  gfx_set(0, 0, 0, 0.35);
  gfx_rect(bx, ty + th2 - 1, bw2, 1);
  gfx_a = 1;

  gfx_set(0.1, 0.1, 0.1);
  gfx_x = w/2 - tw/2;
  gfx_y = ty + (th2 - thh)/2;
  gfx_drawstr(str);
);

// real-looking push button: raised when off, pressed in when on, LED beside it
function pbtn(id, x, y, bw2, bh2, v, txt, lr, lg, lb)
  local(tw, thh, lx2, ly2, lrad, oy, tx, ty)
(
  ((mouse_cap & 1) && (last_cap == 0) && (mouse_x >= x) && (mouse_x < x + bw2) && (mouse_y >= y) && (mouse_y < y + bh2)) ? (
    v = 1 - v;
    changed = id;
  );

  // recess and shadow
  gfx_set(0, 0, 0, 0.5);
  gfx_rect(x - 1, y - 1, bw2 + 3, bh2 + 3);
  gfx_a = 1;
  gfx_set(0.03, 0.03, 0.03);
  gfx_rect(x - 1, y - 1, bw2 + 2, bh2 + 2);

  // face
  oy = (v > 0.5) ? 1 : 0;
  (v > 0.5) ? vgrad(x, y + oy, bw2, bh2 - oy, 0.62, 0.78) : vgrad(x, y, bw2, bh2, 0.95, 0.66);

  // bevel
  (v > 0.5) ? (
    gfx_set(0, 0, 0, 0.45);
    gfx_rect(x, y + oy, bw2, 2);
    gfx_a = 1;
  ) : (
    gfx_set(1, 1, 1, 0.8);
    gfx_rect(x, y, bw2, 1);
    gfx_rect(x, y, 1, bh2);
    gfx_set(0, 0, 0, 0.4);
    gfx_rect(x, y + bh2 - 1, bw2, 1);
    gfx_rect(x + bw2 - 1, y, 1, bh2);
    gfx_a = 1;
  );

  // engraved text
  gfx_setfont(2);
  gfx_measurestr(txt, tw, thh);
  tx = x + (bw2 - tw)/2;
  ty = y + (bh2 - thh)/2 + oy;
  gfx_set(1, 1, 1, 0.55);
  gfx_x = tx;
  gfx_y = ty + 1;
  gfx_drawstr(txt);
  gfx_a = 1;
  gfx_set(0.1, 0.1, 0.1);
  gfx_x = tx;
  gfx_y = ty;
  gfx_drawstr(txt);

  // LED in a metal bezel
  lrad = bh2*0.22;
  lx2 = x + bw2 + lrad*2.6;
  ly2 = y + bh2/2;
  gfx_set(0.02, 0.02, 0.02);
  gfx_circle(lx2, ly2, lrad + 1.5, 1, 1);
  gfx_set(0.45, 0.45, 0.45);
  gfx_circle(lx2, ly2, lrad + 1, 0, 1);
  (v > 0.5) ? (
    gfx_set(lr, lg, lb, 0.16);
    gfx_circle(lx2, ly2, lrad*2.4, 1, 1);
    gfx_set(lr, lg, lb, 0.28);
    gfx_circle(lx2, ly2, lrad*1.7, 1, 1);
    gfx_a = 1;
    gfx_set(lr, lg, lb);
    gfx_circle(lx2, ly2, lrad, 1, 1);
    gfx_set(1, 1, 1, 0.65);
    gfx_circle(lx2 - lrad*0.3, ly2 - lrad*0.3, lrad*0.35, 1, 1);
    gfx_a = 1;
  ) : (
    gfx_set(lr*0.18, lg*0.18, lb*0.18);
    gfx_circle(lx2, ly2, lrad, 1, 1);
    gfx_set(1, 1, 1, 0.15);
    gfx_circle(lx2 - lrad*0.3, ly2 - lrad*0.3, lrad*0.35, 1, 1);
    gfx_a = 1;
  );
  v;
);

function kcell(id, cx, yt, v, top, lo, hi)
  local(cy)
(
  cy = yt + unit*0.47 + kdown;
  v = knob(id, cx, cy, kr, v);
  gfx_setfont(1);
  gfx_set(0.82, 0.82, 0.82);
  label(top, cx, yt);
  label(lo, cx - kr*0.95, cy + kr*1.1);
  label(hi, cx + kr*0.95, cy + kr*1.1);
  v;
);

// gain knob: "dB" on top, drawn minus / plus signs at the ends
function gcell(id, cx, yt, v)
  local(cy, sx, sy, sz)
(
  cy = yt + unit*0.47 + kdown;
  v = knob(id, cx, cy, kr, v);
  gfx_setfont(1);
  gfx_set(0.82, 0.82, 0.82);
  label("dB", cx, yt);
  sz = fs*0.35;
  sy = cy + kr*1.1 + fs*0.5;
  sx = cx - kr*0.95;
  gfx_line(sx - sz, sy, sx + sz, sy);
  sx = cx + kr*0.95;
  gfx_line(sx - sz, sy, sx + sz, sy);
  gfx_line(sx, sy - sz, sx, sy + sz);
  v;
);

function qcell(id, cx, yt, v)
  local(cy, by)
(
  cy = yt + unit*0.47 + kdown;
  v = knob(id, cx, cy, kr, v);
  gfx_setfont(1);
  gfx_set(0.82, 0.82, 0.82);
  label("Q", cx, yt);
  by = cy + kr*1.1 + fs;
  bellicon(cx - kr*0.95, by, fs*0.55, fs*0.9, 14);
  bellicon(cx + kr*0.95, by, fs*0.55, fs*0.6, 3);
  v;
);

@gfx 120 760
gfx_clear = 0x262626;
gfx_a = 1;
gfx_ext_flags = 256;

w = gfx_w;
h = gfx_h;

// rebuild the panel texture only when the strip size changes
((w != bg_w) || (h != bg_h)) ? (
  bg_w = w;
  bg_h = h;
  build_bg(w, h);
);
gfx_x = 0;
gfx_y = 0;
gfx_blit(1, 1, 0);

m = max(3, w * 0.03);

// 2 columns
cw = (w - 2*m) / 2;
cx1 = m + cw*0.5;
cx2 = m + cw*1.5;
cxc = w / 2;

// Row weights (total 11.1)
unit = (h - 2*m) / 11.1;
yA = m;                 // INPUT / OUTPUT
yB = yA + unit;         // EQ IN button
yC = yB + unit*0.4;     // filters tab
yD = yC + unit*0.3;     // filters knobs
yE = yD + unit;         // FL button
yF = yE + unit*0.4;     // HF tab
yG = yF + unit*0.3;     // HF knobs
yH = yG + unit;         // HB button
yI = yH + unit*0.4;     // HMF tab
yJ = yI + unit*0.3;     // HMF knobs
yK = yJ + unit;         // HMF Q
yL = yK + unit;         // LMF tab
yM = yL + unit*0.3;     // LMF knobs
yN = yM + unit;         // LMF Q
yO = yN + unit;         // LF tab
yP = yO + unit*0.3;     // LF knobs
yQ = yP + unit;         // LB button

kr = min(cw*0.32, unit*0.28);
th2 = unit*0.3;
bhh = unit*0.3;
bwb = w*0.28;
bx = cxc - bwb/2 - bhh*0.4;
by_off = unit*0.05;

fs = max(8, min(cw, unit)*0.19);
gfx_setfont(1, "Arial", fs);
gfx_setfont(2, "Arial", fs*1.05, 98);

changed = 0;

// EQ IN
slider19 = pbtn(19, bx, yB + by_off, bwb, bhh, slider19, "IN", 0.3, 1, 0.3);

// Input / Output
setcol(0.22, 0.22, 0.22);
slider17 = kcell(17, cx1, yA, slider17, "INPUT dB", "-24", "+24");
slider18 = kcell(18, cx2, yA, slider18, "OUTPUT dB", "-24", "+24");

// Filters
tab("FILTERS", yC, th2);
setcol(0.66, 0.66, 0.62);
slider1 = kcell(1, cx1, yD, slider1, "HP Hz", "16", "350");
slider2 = kcell(2, cx2, yD, slider2, "LP kHz", "1", "20");
slider5 = pbtn(5, bx, yE + by_off, bwb, bhh, slider5, "FL", 0.3, 1, 0.3);

// HF
tab("HF", yF, th2);
setcol(0.72, 0.25, 0.22);
slider3 = gcell(3, cx1, yG, slider3);
slider7 = kcell(7, cx2, yG, slider7, "kHz", "1.5", "16");
slider8 = pbtn(8, bx, yH + by_off, bwb, bhh, slider8, "HB", 1, 0.25, 0.2);

// HMF
tab("HMF", yI, th2);
setcol(0.2, 0.62, 0.4);
slider9  = gcell(9, cx1, yJ, slider9);
slider10 = kcell(10, cx2, yJ, slider10, "kHz", ".6", "7");
slider11 = qcell(11, cxc, yK, slider11);

// LMF
tab("LMF", yL, th2);
setcol(0.2, 0.45, 0.68);
slider12 = gcell(12, cx1, yM, slider12);
slider13 = kcell(13, cx2, yM, slider13, "kHz", ".2", "2.5");
slider14 = qcell(14, cxc, yN, slider14);

// LF
tab("LF", yO, th2);
setcol(0.55, 0.38, 0.22);
slider4  = gcell(4, cx1, yP, slider4);
slider15 = kcell(15, cx2, yP, slider15, "Hz", "30", "450");
slider16 = pbtn(16, bx, yQ + by_off, bwb, bhh, slider16, "LB", 1, 0.25, 0.2);

// floating value readout while dragging (drawn last so it sits on top)
((drag != 0) && (mouse_cap & 1)) ? (
  valstr(drag, slider(drag));
  tipbox();
);

(changed == 1)  ? slider_automate(slider1);
(changed == 2)  ? slider_automate(slider2);
(changed == 3)  ? slider_automate(slider3);
(changed == 4)  ? slider_automate(slider4);
(changed == 5)  ? slider_automate(slider5);
(changed == 7)  ? slider_automate(slider7);
(changed == 8)  ? slider_automate(slider8);
(changed == 9)  ? slider_automate(slider9);
(changed == 10) ? slider_automate(slider10);
(changed == 11) ? slider_automate(slider11);
(changed == 12) ? slider_automate(slider12);
(changed == 13) ? slider_automate(slider13);
(changed == 14) ? slider_automate(slider14);
(changed == 15) ? slider_automate(slider15);
(changed == 16) ? slider_automate(slider16);
(changed == 17) ? slider_automate(slider17);
(changed == 18) ? slider_automate(slider18);
(changed == 19) ? slider_automate(slider19);

last_cap = mouse_cap & 1;
(last_cap == 0) ? (drag = 0);