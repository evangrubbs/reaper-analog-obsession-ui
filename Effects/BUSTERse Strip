desc:BUSTERse Wrapper UI
slider1:0.7<0,1,0.001>Threshold
slider2:0<0,1,0.001>Make-up
slider3:0.8<0,1,0.2>Attack
slider4:1<0,1,0.25>Release
slider5:0.6<0,1,0.2>Ratio
slider6:1<0,1,0.001>Mix

@init
// Meter calibration (dB). Raise it if the needle shows MORE compression
// than BUSTERse's own meter, lower it if it shows LESS.
cal_db = -20;

drag = 0;
last_cap = 0;
changed = 0;
last_click_id = 0;
last_click_t = 0;
colr = 0.5; colg = 0.5; colb = 0.5;
gr = 0;
dispv = 0;
lx = 0; ly = 0;
bg_w = 0;
bg_h = 0;
gfx_ext_flags = 256;

// ---- DEFAULTS (double-click reset values, 0..1) ----
defv = 100;
defv[1] = 0.7;   // Threshold -9 dB  (range -15..+15)
defv[2] = 0;     // Make-up 0 dB     (range 0..+15)
defv[3] = 0.8;   // Attack 10 ms     (6 steps: .1 .3 1 3 10 30)
defv[4] = 1;     // Release Auto     (5 steps: .1 .3 .6 1.2 Auto)
defv[5] = 0.6;   // Ratio 4          (6 steps: 1.5 2 3 4 5 10)
defv[6] = 1;     // Mix 100% wet

// ---- tables for the meter model ----
att_tab = 200;
att_tab[0] = 0.1; att_tab[1] = 0.3; att_tab[2] = 1;
att_tab[3] = 3;   att_tab[4] = 10;  att_tab[5] = 30;
rel_tab = 210;
rel_tab[0] = 0.1; rel_tab[1] = 0.3; rel_tab[2] = 0.6;
rel_tab[3] = 1.2; rel_tab[4] = 0.3;   // Auto approximated as 0.3 s
rat_tab = 220;
rat_tab[0] = 1.5; rat_tab[1] = 2; rat_tab[2] = 3;
rat_tab[3] = 4;   rat_tab[4] = 5; rat_tab[5] = 10;

function setcol(r, g, b)
(
  colr = r; colg = g; colb = b;
);

// vertical grey gradient, built from 1px rows
function vgrad(x, y, w2, h2, c0, c1)
  local(i, n, c)
(
  n = max(1, floor(h2));
  i = 0;
  loop(n,
    c = c0 + (c1 - c0)*(i/n);
    gfx_set(c, c, c);
    gfx_rect(x, y + i, w2, 1);
    i += 1;
  );
);

function knob(id, x, y, r, v, steps)
  local(a, dx, dy, now, i, t, sens, n)
(
  dx = mouse_x - x;
  dy = mouse_y - y;
  now = time_precise();

  ((mouse_cap & 1) && (last_cap == 0) && ((dx*dx + dy*dy) < (r*r*1.3))) ? (
    ((last_click_id == id) && ((now - last_click_t) < 0.35)) ? (
      // double-click: reset to this knob's default
      v = defv[id];
      changed = id;
      drag = 0;
      last_click_id = 0;
    ) : (
      drag = id;
      dragy = mouse_y;
      dragv = v;
      last_click_id = id;
      last_click_t = now;
    );
  );

  sens = (steps > 0) ? 0.01 : 0.005;
  ((drag == id) && (mouse_cap & 1)) ? (
    v = max(0, min(1, dragv + (dragy - mouse_y) * sens));
    (steps > 0) ? ( v = floor(v*(steps-1) + 0.5)/(steps-1); );
    changed = id;
  );

  // tick dots (one per detent for stepped knobs)
  n = (steps > 0) ? steps : 11;
  gfx_set(0.88, 0.88, 0.88);
  i = 0;
  loop(n,
    t = $pi*0.75 + (i/(n-1))*$pi*1.5;
    gfx_circle(x + cos(t)*r*1.3, y + sin(t)*r*1.3, max(1, r*0.07), 1, 1);
    i += 1;
  );

  // drop shadow
  gfx_set(0, 0, 0, 0.4);
  gfx_circle(x + r*0.1, y + r*0.2, r + 2, 1, 1);
  gfx_a = 1;

  // skirt, metal rim, cap
  gfx_set(0.04, 0.04, 0.04);
  gfx_circle(x, y, r + 1.5, 1, 1);
  gfx_set(0.55, 0.55, 0.55);
  gfx_circle(x, y, r + 0.5, 1, 1);
  gfx_set(colr*0.55, colg*0.55, colb*0.55);
  gfx_circle(x, y, r - 0.5, 1, 1);
  gfx_set(colr, colg, colb);
  gfx_circle(x, y, r*0.88, 1, 1);

  // soft light from top-left, shade at bottom-right
  gfx_set(1, 1, 1, 0.16);
  gfx_circle(x - r*0.18, y - r*0.24, r*0.55, 1, 1);
  gfx_set(0, 0, 0, 0.16);
  gfx_circle(x + r*0.22, y + r*0.28, r*0.5, 1, 1);
  gfx_a = 1;

  // pointer
  a = $pi*0.75 + v*$pi*1.5;
  gfx_set(1, 1, 1);
  gfx_line(x + cos(a)*r*0.2, y + sin(a)*r*0.2, x + cos(a)*r*0.95, y + sin(a)*r*0.95);
  gfx_line(x + cos(a)*r*0.2 + 1, y + sin(a)*r*0.2, x + cos(a)*r*0.95 + 1, y + sin(a)*r*0.95);
  v;
);

// text with a dark drop shadow so it stays readable on the metal
function label(str, cx, ty)
  local(tw, th, sr, sg, sb)
(
  sr = gfx_r; sg = gfx_g; sb = gfx_b;
  gfx_measurestr(str, tw, th);
  gfx_set(0, 0, 0, 0.9);
  gfx_x = cx - tw/2 + 1;
  gfx_y = ty + 1;
  gfx_drawstr(str);
  gfx_set(sr, sg, sb);
  gfx_x = cx - tw/2;
  gfx_y = ty;
  gfx_drawstr(str);
);

// scale label placed around the last knob drawn (frac 0 = min, 1 = max)
function tlab(str, frac)
  local(t)
(
  t = $pi*0.75 + frac*$pi*1.5;
  gfx_setfont(1);
  gfx_set(0.96, 0.96, 0.96);
  label(str, lx + cos(t)*kr*1.7, ly + sin(t)*kr*1.7 - fs*0.5);
);

function ccell(id, cx, yt, v, steps, top, name)
  local(cy)
(
  cy = yt + rowh*0.45;
  lx = cx;
  ly = cy;
  v = knob(id, cx, cy, kr, v, steps);
  gfx_setfont(1);
  gfx_set(0.92, 0.92, 0.92);
  label(top, cx, cy - kr*1.3 - fs*1.6);
  gfx_setfont(2);
  gfx_set(1, 1, 1);
  label(name, cx, cy + kr*1.2 + fs*0.9);
  v;
);

// matte metal panel, drawn once into image buffer 1
function build_bg(bw, bh)
  local(x, y, n, rn, base)
(
  gfx_setimgdim(1, bw, bh);
  gfx_dest = 1;
  y = 0;
  loop(bh,
    rn = sin(y*4.1414)*43758.5453;
    rn = rn - floor(rn);
    x = 0;
    loop(bw,
      n = sin(x*12.9898 + y*78.233)*43758.5453;
      n = n - floor(n);
      base = 0.20 - 0.04*(y/bh) + (n - 0.5)*0.045 + (rn - 0.5)*0.012;
      gfx_x = x;
      gfx_y = y;
      gfx_setpixel(base, base, base);
      x += 1;
    );
    y += 1;
  );
  // panel edge bevel
  gfx_set(1, 1, 1, 0.14);
  gfx_rect(0, 0, bw, 1);
  gfx_rect(0, 0, 1, bh);
  gfx_set(0, 0, 0, 0.5);
  gfx_rect(0, bh - 1, bw, 1);
  gfx_rect(bw - 1, 0, 1, bh);
  gfx_a = 1;
  gfx_dest = -1;
);

function mtick(v, str)
  local(a, ca, sa)
(
  a = $pi*1.15 + (v/20)*$pi*0.7;
  ca = cos(a);
  sa = sin(a);
  gfx_set(0.95, 0.95, 0.95);
  gfx_line(px + ca*L*0.86, py + sa*L*0.86, px + ca*L*0.97, py + sa*L*0.97);
  label(str, px + ca*L*0.70, py + sa*L*0.70 - fm*0.5);
);

@block
thr_db = -15 + slider1*30 + cal_db;
att_ms = att_tab[floor(slider3*5 + 0.5)];
att_c = exp(-1/(att_ms*0.001*srate));
rel_s = rel_tab[floor(slider4*4 + 0.5)];
rel_c = exp(-1/(rel_s*srate));
slope = 1 - 1/rat_tab[floor(slider5*5 + 0.5)];

@sample
// Estimated gain reduction for the meter only. Audio is not modified.
lvl = max(abs(spl0), abs(spl1));
ldb = 20*log10(lvl + 0.000000001);
over = ldb - thr_db;
tgt = (over > 0) ? over*slope : 0;
(tgt > gr) ? ( gr += (tgt - gr)*(1 - att_c); ) : ( gr += (tgt - gr)*(1 - rel_c); );

@gfx 120 380
gfx_clear = 0x262626;
gfx_a = 1;
gfx_ext_flags = 256;

w = gfx_w;
h = gfx_h;

// rebuild the panel texture only when the strip size changes
((w != bg_w) || (h != bg_h)) ? (
  bg_w = w;
  bg_h = h;
  build_bg(w, h);
);
gfx_x = 0;
gfx_y = 0;
gfx_blit(1, 1, 0);

m = max(3, w * 0.03);

cw = (w - 2*m) / 2;
cx1 = m + cw*0.5;
cx2 = m + cw*1.5;

// meter 0.75 units, then 3 knob rows of 1.3 units = 4.65
u = (h - 2*m) / 4.65;
rowh = u*1.3;
mh = u*0.62;
y1 = m + u*0.75;
y2 = y1 + rowh;
y3 = y2 + rowh;

kr = min(cw*0.24, rowh*0.2);
fs = max(9, min(cw*0.19, rowh*0.115));
fm = max(8, fs*0.85);
fnm = max(8, fs*0.92);
gfx_setfont(1, "Arial", fs);
gfx_setfont(2, "Arial", fnm, 98);
gfx_setfont(3, "Arial", fm);

// ---- Compression meter (metal bezel, recessed dark face) ----
mw = w - 2*m;
gfx_set(0, 0, 0, 0.5);
gfx_rect(m - 1, m - 1, mw + 3, mh + 3);
gfx_a = 1;
vgrad(m, m, mw, mh, 0.62, 0.30);
gfx_set(0.02, 0.02, 0.02);
gfx_rect(m + 3, m + 3, mw - 6, mh - 6);
gfx_set(0.10, 0.10, 0.11);
gfx_rect(m + 4, m + 4, mw - 8, mh - 8);
gfx_set(1, 1, 1, 0.05);
gfx_rect(m + 4, m + 4, mw - 8, (mh - 8)*0.45);
gfx_a = 1;

px = w/2;
py = m + mh*0.86;
L = min(mh*0.72, mw*0.42);

dispv = dispv*0.85 + gr*0.15;

gfx_setfont(3);
mtick(0, "0");
mtick(4, "4");
mtick(8, "8");
mtick(12, "12");
mtick(16, "16");
mtick(20, "20");
gfx_set(0.95, 0.95, 0.95);
label("dB", px, py - L*0.42);

nv = max(0, min(20, dispv));
na = $pi*1.15 + (nv/20)*$pi*0.7;
gfx_set(1, 1, 1);
gfx_line(px, py, px + cos(na)*L*0.95, py + sin(na)*L*0.95);
gfx_line(px + 1, py, px + 1 + cos(na)*L*0.95, py + sin(na)*L*0.95);
gfx_circle(px, py, max(2, fs*0.25), 1, 1);

// ---- Knobs ----
changed = 0;
setcol(0.26, 0.26, 0.28);

// Row 1: threshold, make-up
slider1 = ccell(1, cx1, y1, slider1, 0, "dB", "THRESHOLD");
tlab("-15", 0);
tlab("+15", 1);
slider2 = ccell(2, cx2, y1, slider2, 0, "dB", "MAKE-UP");
tlab("0", 0);
tlab("+15", 1);

// Row 2: attack, release
slider3 = ccell(3, cx1, y2, slider3, 6, " ", "ATTACK ms");
tlab(".1", 0);
tlab(".3", 0.2);
tlab("1", 0.4);
tlab("3", 0.6);
tlab("10", 0.8);
tlab("30", 1);
slider4 = ccell(4, cx2, y2, slider4, 5, " ", "RELEASE S");
tlab(".1", 0);
tlab(".3", 0.25);
tlab(".6", 0.5);
tlab("1.2", 0.75);
tlab("Auto", 1);

// Row 3: ratio, mix
slider5 = ccell(5, cx1, y3, slider5, 6, " ", "RATIO");
tlab("1.5", 0);
tlab("2", 0.2);
tlab("3", 0.4);
tlab("4", 0.6);
tlab("5", 0.8);
tlab("10", 1);
slider6 = ccell(6, cx2, y3, slider6, 0, "%", "MIX");
tlab("DRY", 0);
tlab("WET", 1);

(changed == 1) ? slider_automate(slider1);
(changed == 2) ? slider_automate(slider2);
(changed == 3) ? slider_automate(slider3);
(changed == 4) ? slider_automate(slider4);
(changed == 5) ? slider_automate(slider5);
(changed == 6) ? slider_automate(slider6);

last_cap = mouse_cap & 1;
(last_cap == 0) ? (drag = 0);
