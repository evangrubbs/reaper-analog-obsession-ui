desc:Analog Obsession EQ Wrapper UI

slider1:0<0,1,0.001>-Low Boost
slider2:0<0,1,0.001>-Low Atten
slider3:0<0,1,0.3333333333333333>-Low Freq
slider4:0<0,1,0.001>-Bandwidth
slider5:0<0,1,0.001>-High Boost
slider6:0<0,1,0.001>-High Atten
slider7:0<0,1,0.1666666666666667>-High Freq
slider8:0<0,1,0.5>-Atten Sel
slider9:0.5<0,1,0.001>-Output


@init

drag = 0;
last_cap = 0;
changed = 0;

last_click_id = 0;
last_click_t = 0;

dragy = 0;
dragv = 0;

bg_w = 0;
bg_h = 0;

lx = 0;
ly = 0;

gfx_ext_flags = 256;


/*
=========================================================
DEFAULT VALUES
=========================================================
*/

defv = 100;

defv[1] = 0;
defv[2] = 0;
defv[3] = 0;
defv[4] = 0;
defv[5] = 0;
defv[6] = 0;
defv[7] = 0;
defv[8] = 0;
defv[9] = 0.5;


/*
=========================================================
TEXT COLOR
=========================================================
*/

text_r = 0.92;
text_g = 0.88;
text_b = 0.79;


/*
=========================================================
KNOB
=========================================================
*/

function knob(id,x,y,r,v,steps)
  local(a,dx,dy,now,i,t,n)
(

  dx = mouse_x-x;
  dy = mouse_y-y;

  now = time_precise();


  /*
=========================================================
CLICK / DOUBLE CLICK RESET
=========================================================
*/

  ((mouse_cap & 1) &&
   (last_cap == 0) &&
   ((dx*dx+dy*dy) < (r*r*1.45))) ?
  (

    ((last_click_id == id) &&
     ((now-last_click_t) < 0.35)) ?

    (
      v = defv[id];

      changed = id;

      drag = 0;

      last_click_id = 0;
    )

    :

    (
      drag = id;

      dragy = mouse_y;

      dragv = v;

      last_click_id = id;

      last_click_t = now;
    );
  );


  /*
=========================================================
DRAG
=========================================================
*/

  ((drag == id) && (mouse_cap & 1)) ?
  (

    v =
      max(
        0,
        min(
          1,
          dragv+(dragy-mouse_y)*0.005
        )
      );


    (steps > 1) ?
    (
      v =
        floor(
          v*(steps-1)+0.5
        )
        /(steps-1);
    );


    changed = id;
  );


  /*
=========================================================
DROP SHADOW
=========================================================
*/

  gfx_set(
    0,
    0,
    0,
    0.55
  );

  gfx_circle(
    x+r*0.10,
    y+r*0.20,
    r+3,
    1,
    1
  );

  gfx_a = 1;


  /*
=========================================================
OUTER SKIRT
=========================================================
*/

  gfx_set(
    0.018,
    0.020,
    0.020
  );

  gfx_circle(
    x,
    y,
    r+1.7,
    1,
    1
  );


  /*
=========================================================
METAL RIM
=========================================================
*/

  gfx_set(
    0.48,
    0.48,
    0.45
  );

  gfx_circle(
    x,
    y,
    r+0.7,
    1,
    1
  );


  /*
=========================================================
INNER RIM
=========================================================
*/

  gfx_set(
    0.055,
    0.065,
    0.065
  );

  gfx_circle(
    x,
    y,
    r-0.4,
    1,
    1
  );


  /*
=========================================================
KNOB CAP
=========================================================
*/

  gfx_set(
    0.085,
    0.095,
    0.095
  );

  gfx_circle(
    x,
    y,
    r*0.88,
    1,
    1
  );


  /*
=========================================================
TOP LEFT HIGHLIGHT
=========================================================
*/

  gfx_set(
    0.95,
    0.95,
    0.92,
    0.11
  );

  gfx_circle(
    x-r*0.18,
    y-r*0.25,
    r*0.55,
    1,
    1
  );


  /*
=========================================================
BOTTOM RIGHT SHADE
=========================================================
*/

  gfx_set(
    0,
    0,
    0,
    0.28
  );

  gfx_circle(
    x+r*0.22,
    y+r*0.28,
    r*0.50,
    1,
    1
  );

  gfx_a = 1;


  /*
=========================================================
POINTER SHADOW
=========================================================
*/

  a =
    $pi*0.75
    +v*$pi*1.5;

  gfx_set(
    0,
    0,
    0,
    0.60
  );

  gfx_line(
    x+cos(a)*r*0.22+1,
    y+sin(a)*r*0.22+1,
    x+cos(a)*r*0.93+1,
    y+sin(a)*r*0.93+1
  );


  /*
=========================================================
POINTER
=========================================================
*/

  gfx_set(
    0.86,
    0.82,
    0.72
  );

  gfx_line(
    x+cos(a)*r*0.22,
    y+sin(a)*r*0.22,
    x+cos(a)*r*0.93,
    y+sin(a)*r*0.93
  );

  gfx_line(
    x+cos(a)*r*0.22+1,
    y+sin(a)*r*0.22,
    x+cos(a)*r*0.93+1,
    y+sin(a)*r*0.93
  );


  /*
=========================================================
TICK DOTS
=========================================================
*/

  n = (steps > 1) ? steps : 11;

  i = 0;

  loop(n,

    t =
      $pi*0.75
      +(i/(n-1))*$pi*1.5;


    /*
        Dark outer dot
    */

    gfx_set(
      0.015,
      0.020,
      0.020,
      1
    );

    gfx_circle(
      x+cos(t)*r*1.34,
      y+sin(t)*r*1.34,
      max(1.45,r*0.075),
      1,
      1
    );


    /*
        Bright center dot
    */

    gfx_set(
      0.84,
      0.80,
      0.69,
      1
    );

    gfx_circle(
      x+cos(t)*r*1.34,
      y+sin(t)*r*1.34,
      max(1.0,r*0.050),
      1,
      1
    );

    i += 1;
  );


  v;
);


/*
=========================================================
TEXT
=========================================================
*/

function label(str,cx,ty)
  local(tw,th,sr,sg,sb)
(

  sr = gfx_r;
  sg = gfx_g;
  sb = gfx_b;

  gfx_measurestr(
    str,
    tw,
    th
  );


  /*
     Shadow
  */

  gfx_set(
    0,
    0,
    0,
    0.85
  );

  gfx_x =
    cx-tw/2+1;

  gfx_y =
    ty+1;

  gfx_drawstr(str);


  /*
     Main text
  */

  gfx_set(
    sr,
    sg,
    sb
  );

  gfx_x =
    cx-tw/2;

  gfx_y =
    ty;

  gfx_drawstr(str);
);


/*
=========================================================
METALLIC TEAL BACKGROUND
=========================================================
*/

function build_bg(bw,bh)
  local(x,y,n,rn,grain,br,bg,bb)
(

  gfx_setimgdim(
    1,
    bw,
    bh
  );

  gfx_dest = 1;

  y = 0;

  loop(bh,

    rn =
      sin(y*4.1414)
      *43758.5453;

    rn =
      rn-floor(rn);

    x = 0;

    loop(bw,

      n =
        sin(
          x*12.9898
          +y*78.233
        )
        *43758.5453;

      n =
        n-floor(n);


      grain =
        (n-0.5)*0.045
        +(rn-0.5)*0.018;


      /*
          Blue / teal faceplate
      */

      br =
        0.185
        +grain;

      bg =
        0.365
        +grain;

      bb =
        0.425
        +grain;


      /*
          Slight vertical shading
      */

      br -=
        0.025*(y/bh);

      bg -=
        0.030*(y/bh);

      bb -=
        0.032*(y/bh);


      gfx_x = x;
      gfx_y = y;

      gfx_setpixel(
        br,
        bg,
        bb
      );

      x += 1;
    );

    y += 1;
  );


  /*
=========================================================
TOP HIGHLIGHT
=========================================================
*/

  gfx_set(
    0.90,
    0.95,
    0.95,
    0.10
  );

  gfx_rect(
    0,
    0,
    bw,
    1
  );


  /*
=========================================================
BOTTOM SHADOW
=========================================================
*/

  gfx_set(
    0,
    0,
    0,
    0.45
  );

  gfx_rect(
    0,
    bh-2,
    bw,
    2
  );

  gfx_a = 1;

  gfx_dest = -1;
);


/*
=========================================================
GFX
=========================================================
*/

@gfx 120 375

gfx_clear = 0x244952;

gfx_a = 1;

gfx_ext_flags = 256;

w = gfx_w;
h = gfx_h;


/*
=========================================================
BACKGROUND
=========================================================
*/

((w != bg_w) || (h != bg_h)) ?
(
  bg_w = w;
  bg_h = h;

  build_bg(
    w,
    h
  );
);


gfx_x = 0;
gfx_y = 0;

gfx_blit(
  1,
  1,
  0
);


/*
=========================================================
KNOB SIZE
=========================================================
*/

kr = 13;


/*
=========================================================
TEXT SIZE
=========================================================
*/

fs = 9;


/*
=========================================================
HORIZONTAL LAYOUT
=========================================================
*/

m =
  max(
    3,
    w*0.03
  );

cw =
  (w-2*m)/2;

cx1 =
  m+cw*0.5;

cx2 =
  m+cw*1.5;

cxc =
  w/2;


/*
=========================================================
VERTICAL LAYOUT
=========================================================
*/

row_gap = 50;


/*
   Overall vertical position.
*/

y1 = 27;


/*
   LOW FREQ / BANDWIDTH
*/

y2 =
  y1+row_gap;


/*
   HIGH BOOST / ATTEN
*/

y3 =
  y2+row_gap;


/*
   HIGH FREQ / ATTEN SEL
*/

y4 =
  y3+row_gap;


/*
   OUTPUT
*/

y5 =
  y4+row_gap;


/*
=========================================================
LABEL SPACING
=========================================================
*/

label_gap = 6;


/*
=========================================================
FONT
=========================================================
*/

gfx_setfont(
  1,
  "Arial",
  fs,
  98
);


/*
=========================================================
LOW BOOST
=========================================================
*/

slider1 =
  knob(
    1,
    cx1,
    y1,
    kr,
    slider1,
    0
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "BOOST",
  cx1,
  y1+kr+label_gap
);


/*
=========================================================
LOW ATTEN
=========================================================
*/

slider2 =
  knob(
    2,
    cx2,
    y1,
    kr,
    slider2,
    0
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "ATTEN",
  cx2,
  y1+kr+label_gap
);


/*
=========================================================
LOW FREQUENCY
=========================================================
*/

slider3 =
  knob(
    3,
    cx1,
    y2,
    kr,
    slider3,
    4
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "LOW FREQ",
  cx1,
  y2+kr+label_gap
);


/*
=========================================================
BANDWIDTH
=========================================================
*/

slider4 =
  knob(
    4,
    cx2,
    y2,
    kr,
    slider4,
    0
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "BANDWIDTH",
  cx2,
  y2+kr+label_gap
);


/*
=========================================================
HIGH BOOST
=========================================================
*/

slider5 =
  knob(
    5,
    cx1,
    y3,
    kr,
    slider5,
    0
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "BOOST",
  cx1,
  y3+kr+label_gap
);


/*
=========================================================
HIGH ATTEN
=========================================================
*/

slider6 =
  knob(
    6,
    cx2,
    y3,
    kr,
    slider6,
    0
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "ATTEN",
  cx2,
  y3+kr+label_gap
);


/*
=========================================================
HIGH FREQUENCY
=========================================================
*/

slider7 =
  knob(
    7,
    cx1,
    y4,
    kr,
    slider7,
    7
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "HIGH FREQ",
  cx1,
  y4+kr+label_gap
);


/*
=========================================================
ATTENUATION SELECTOR
=========================================================
*/

slider8 =
  knob(
    8,
    cx2,
    y4,
    kr,
    slider8,
    3
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "ATTEN SEL",
  cx2,
  y4+kr+label_gap
);


/*
=========================================================
OUTPUT
=========================================================
*/

slider9 =
  knob(
    9,
    cxc,
    y5,
    kr,
    slider9,
    0
  );

gfx_set(
  text_r,
  text_g,
  text_b
);

label(
  "OUTPUT",
  cxc,
  y5+kr+label_gap
);


/*
=========================================================
AUTOMATION
=========================================================
*/

(changed == 1) ?
  slider_automate(slider1);

(changed == 2) ?
  slider_automate(slider2);

(changed == 3) ?
  slider_automate(slider3);

(changed == 4) ?
  slider_automate(slider4);

(changed == 5) ?
  slider_automate(slider5);

(changed == 6) ?
  slider_automate(slider6);

(changed == 7) ?
  slider_automate(slider7);

(changed == 8) ?
  slider_automate(slider8);

(changed == 9) ?
  slider_automate(slider9);


/*
=========================================================
MOUSE STATE
=========================================================
*/

last_cap =
  mouse_cap & 1;

(last_cap == 0) ?
  (drag = 0);
