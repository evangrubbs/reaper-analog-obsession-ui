desc:VariMoon Wrapper UI

slider1:0<0,5,1>-Release
slider2:0<0,1,0.001>-Threshold


@init

drag = 0;
last_cap = 0;
changed = 0;

last_click_id = 0;
last_click_t = 0;

dragy = 0;
dragv = 0;

lx = 0;
ly = 0;

bg_w = 0;
bg_h = 0;

gfx_ext_flags = 256;


/*
=========================================================
DEFAULTS
=========================================================
*/

defv = 100;

defv[1] = 0;
defv[2] = 0.25;


/*
=========================================================
KNOB
=========================================================
*/

function knob(id,x,y,r,v,stepped)
  local(a,dx,dy,now,i,t,n)
(
  dx = mouse_x-x;
  dy = mouse_y-y;

  now = time_precise();


  /*
=========================================================
CLICK / DOUBLE-CLICK RESET
=========================================================
*/

  ((mouse_cap & 1) &&
   (last_cap == 0) &&
   ((dx*dx + dy*dy) < (r*r*1.35))) ?
  (

    ((last_click_id == id) &&
     ((now-last_click_t) < 0.35)) ?

    (
      v = defv[id];

      changed = id;

      drag = 0;

      last_click_id = 0;
    )

    :

    (
      drag = id;

      dragy = mouse_y;

      dragv = v;

      last_click_id = id;

      last_click_t = now;
    );
  );


  /*
=========================================================
DRAG
=========================================================
*/

  ((drag == id) && (mouse_cap & 1)) ?
  (

    v =
      max(
        0,
        min(
          1,
          dragv+(dragy-mouse_y)*0.005
        )
      );


    stepped ?
    (
      v =
        floor(v*5+0.5)/5;
    );


    changed = id;
  );


  /*
=========================================================
SELECTOR DOTS
=========================================================
*/

  stepped ?
  (

    /*
       Release: six warm brass selector marks
    */

    n = 6;

    i = 0;

    loop(n,

      t =
        $pi*0.75
        +i*$pi*0.15;


      /*
         Dark outer halo
      */

      gfx_set(
        0.025,
        0.022,
        0.020
      );

      gfx_circle(
        x+cos(t)*r*1.30,
        y+sin(t)*r*1.30,
        max(1.6,r*0.075),
        1,
        1
      );


      /*
         Warm brass mark
      */

      gfx_set(
        0.62,
        0.46,
        0.30
      );

      gfx_circle(
        x+cos(t)*r*1.30,
        y+sin(t)*r*1.30,
        max(1.05,r*0.050),
        1,
        1
      );

      i += 1;
    );
  )

  :

  (

    /*
       Threshold: continuous selector dots
    */

    n = 11;

    i = 0;

    loop(n,

      t =
        $pi*0.75
        +i*$pi*0.15;


      gfx_set(
        0.78,
        0.68,
        0.54
      );

      gfx_circle(
        x+cos(t)*r*1.30,
        y+sin(t)*r*1.30,
        max(1.0,r*0.055),
        1,
        1
      );

      i += 1;
    );
  );


  /*
=========================================================
DROP SHADOW
=========================================================
*/

  gfx_set(
    0,
    0,
    0,
    0.55
  );

  gfx_circle(
    x+r*0.10,
    y+r*0.20,
    r+2,
    1,
    1
  );

  gfx_a = 1;


  /*
=========================================================
BLACK OUTER SKIRT
=========================================================
*/

  gfx_set(
    0.018,
    0.017,
    0.016
  );

  gfx_circle(
    x,
    y,
    r+1.5,
    1,
    1
  );


  /*
=========================================================
WARM METAL RIM
=========================================================
*/

  gfx_set(
    0.42,
    0.35,
    0.28
  );

  gfx_circle(
    x,
    y,
    r+0.5,
    1,
    1
  );


  /*
=========================================================
DARK INNER RIM
=========================================================
*/

  gfx_set(
    0.055,
    0.050,
    0.045
  );

  gfx_circle(
    x,
    y,
    r-0.5,
    1,
    1
  );


  /*
=========================================================
BLACK KNOB CAP
=========================================================
*/

  gfx_set(
    0.085,
    0.080,
    0.075
  );

  gfx_circle(
    x,
    y,
    r*0.88,
    1,
    1
  );


  /*
=========================================================
TOP-LEFT METAL LIGHT
=========================================================
*/

  gfx_set(
    0.92,
    0.84,
    0.70,
    0.10
  );

  gfx_circle(
    x-r*0.18,
    y-r*0.24,
    r*0.55,
    1,
    1
  );


  /*
=========================================================
BOTTOM-RIGHT SHADOW
=========================================================
*/

  gfx_set(
    0,
    0,
    0,
    0.27
  );

  gfx_circle(
    x+r*0.22,
    y+r*0.28,
    r*0.50,
    1,
    1
  );

  gfx_a = 1;


  /*
=========================================================
POINTER
=========================================================
*/

  a =
    $pi*0.75
    +v*$pi*1.5;


  gfx_set(
    0.78,
    0.63,
    0.43
  );


  gfx_line(
    x+cos(a)*r*0.25,
    y+sin(a)*r*0.25,
    x+cos(a)*r*0.95,
    y+sin(a)*r*0.95
  );

  gfx_line(
    x+cos(a)*r*0.25+1,
    y+sin(a)*r*0.25,
    x+cos(a)*r*0.95+1,
    y+sin(a)*r*0.95
  );


  v;
);


/*
=========================================================
SHADOWED TEXT
=========================================================
*/

function label(str,cx,ty)
  local(tw,th,sr,sg,sb)
(
  sr = gfx_r;
  sg = gfx_g;
  sb = gfx_b;

  gfx_measurestr(
    str,
    tw,
    th
  );


  /*
     Dark shadow
  */

  gfx_set(
    0,
    0,
    0,
    0.85
  );

  gfx_x =
    cx-tw/2+1;

  gfx_y =
    ty+1;

  gfx_drawstr(str);


  /*
     Main text
  */

  gfx_set(
    sr,
    sg,
    sb
  );

  gfx_x =
    cx-tw/2;

  gfx_y =
    ty;

  gfx_drawstr(str);
);


/*
=========================================================
SCALE LABEL
=========================================================
*/

function tlab(str,frac)
  local(t)
(
  t =
    $pi*0.75
    +frac*$pi*1.5;


  gfx_setfont(3);


  /*
     Brighter warm brass text
  */

  gfx_set(
    0.78,
    0.61,
    0.40
  );


  label(
    str,
    lx+cos(t)*kr*1.47,
    ly+sin(t)*kr*1.47-fnum*0.5
  );
);


/*
=========================================================
CONTROL CELL
=========================================================
*/

function ccell(id,cx,cy,v)
(
  lx = cx;
  ly = cy;

  v =
    knob(
      id,
      cx,
      cy,
      kr,
      v,
      id == 1
    );

  v;
);


/*
=========================================================
MATTE METALLIC BACKGROUND
=========================================================
*/

function build_bg(bw,bh)
  local(x,y,n,rn,base)
(
  gfx_setimgdim(
    1,
    bw,
    bh
  );

  gfx_dest = 1;

  y = 0;

  loop(bh,

    rn =
      sin(y*4.1414)
      *43758.5453;

    rn =
      rn-floor(rn);


    x = 0;

    loop(bw,

      n =
        sin(
          x*12.9898
          +y*78.233
        )
        *43758.5453;

      n =
        n-floor(n);


      base =
        0.105
        -0.025*(y/bh)
        +(n-0.5)*0.035
        +(rn-0.5)*0.012;


      gfx_x = x;
      gfx_y = y;

      gfx_setpixel(
        base*1.02,
        base*0.97,
        base*0.91
      );


      x += 1;
    );

    y += 1;
  );


  /*
=========================================================
SUBTLE TOP LIGHT
=========================================================
*/

  gfx_set(
    0.72,
    0.57,
    0.39,
    0.045
  );

  gfx_rect(
    0,
    0,
    bw,
    2
  );


  /*
=========================================================
SUBTLE BOTTOM SHADOW
=========================================================
*/

  gfx_set(
    0,
    0,
    0,
    0.35
  );

  gfx_rect(
    0,
    bh-2,
    bw,
    2
  );

  gfx_a = 1;

  gfx_dest = -1;
);


/*
=========================================================
GFX
=========================================================
*/

@gfx 120 80

gfx_clear = 0x191817;

gfx_a = 1;

gfx_ext_flags = 256;

w = gfx_w;
h = gfx_h;


/*
=========================================================
BACKGROUND
=========================================================
*/

((w != bg_w) || (h != bg_h)) ?
(
  bg_w = w;
  bg_h = h;

  build_bg(
    w,
    h
  );
);


gfx_x = 0;
gfx_y = 0;

gfx_blit(
  1,
  1,
  0
);


/*
=========================================================
LAYOUT
=========================================================
*/

m =
  max(
    3,
    w*0.03
  );

cw =
  (w-2*m)/2;

cx1 =
  m+cw*0.5;

cx2 =
  m+cw*1.5;


/*
=========================================================
KNOB SIZE
=========================================================
*/

kr =
  min(
    cw*0.30,
    h*0.20
  );


/*
=========================================================
TEXT SIZES
=========================================================
*/

fs =
  max(
    8,
    min(
      cw*0.17,
      h*0.09
    )
  );

fnum =
  max(
    8,
    fs*1.15
  );

fb1 =
  max(
    8,
    h*0.085
  );

fb2 =
  max(
    10,
    h*0.125
  );


/*
=========================================================
VERTICAL POSITION
=========================================================
*/

yc =
  h*0.55-6;


/*
=========================================================
LABEL POSITION
=========================================================

Labels intentionally sit close to the knobs.
=========================================================
*/

namey =
  yc
  +kr*1.02
  +fs*0.48;


/*
=========================================================
FONT SETUP
=========================================================
*/

gfx_setfont(
  1,
  "Arial",
  fs
);

gfx_setfont(
  2,
  "Arial",
  fs,
  98
);

gfx_setfont(
  3,
  "Arial",
  fnum
);

gfx_setfont(
  4,
  "Arial",
  fb1,
  105
);

gfx_setfont(
  5,
  "Arial",
  fb2,
  105
);


/*
=========================================================
RELEASE KNOB
=========================================================
*/

slider1 =
  ccell(
    1,
    cx1,
    yc,
    slider1/5
  );


/*
=========================================================
RELEASE SCALE
=========================================================
*/

tlab("1",0);
tlab("2",0.2);
tlab("3",0.4);
tlab("4",0.6);
tlab("5",0.8);
tlab("6",1);


/*
=========================================================
RELEASE LABEL
=========================================================
*/

gfx_setfont(2);

gfx_set(
  0.78,
  0.61,
  0.40
);

label(
  "REL",
  cx1,
  namey
);


/*
=========================================================
THRESHOLD KNOB
=========================================================
*/

slider2 =
  ccell(
    2,
    cx2,
    yc,
    slider2
  );


/*
=========================================================
THRESHOLD LABEL
=========================================================
*/

gfx_setfont(2);

gfx_set(
  0.78,
  0.61,
  0.40
);

label(
  "THRESH",
  cx2,
  namey
);


/*
=========================================================
CONVERT RELEASE BACK TO 0-5
=========================================================
*/

slider1 =
  floor(
    slider1*5+0.5
  );


/*
=========================================================
AUTOMATION
=========================================================
*/

(changed == 1) ?
  slider_automate(slider1);

(changed == 2) ?
  slider_automate(slider2);


/*
=========================================================
MOUSE STATE
=========================================================
*/

last_cap =
  mouse_cap & 1;

(last_cap == 0) ?
  (drag = 0);
